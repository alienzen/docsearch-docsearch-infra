# ─────────────────────────────────────────────────────────────
#  DocSearch — configuration applicative
#  À installer sur chaque machine dans /etc/docsearch/docsearch.env
#  (remplace l'ancien .env de Docker Compose)
# ─────────────────────────────────────────────────────────────
#
# ⚠️ DIFFÉRENCE MAJEURE AVEC .env : ce fichier est lu par systemd
# (EnvironmentFile=), qui ne fait AUCUNE substitution. Pas de
# ${VAR:-defaut}, pas de valeur implicite : toute variable absente d'ici
# est absente du conteneur. Les valeurs par défaut qui vivaient dans
# docker-compose.yml (bloc x-app-env) sont donc toutes écrites ci-dessous.
#
# Pas de guillemets autour des valeurs : systemd les prendrait au pied de
# la lettre et les transmettrait au conteneur.
#
# Après toute modification :
#   sudo systemctl restart docsearch.target

# ── Elasticsearch ─────────────────────────────────────────────
# Adresse vue DEPUIS LES CONTENEURS. En mono-hôte, "es01-dev" est un
# alias réseau du conteneur Elasticsearch (voir docsearch-es01.container).
# En multi-hôte, mettre l'IP réelle du nœud : http://192.168.10.11:9200
ES_HOST=http://es01-dev:9200
ES_INDEX=documents
ES_SEARCH_ALIAS=docsearch-all
SAVED_COLLECTIONS_INDEX=saved_collections
CUSTOM_KEYWORDS_INDEX=custom_keywords

# ── Kafka ─────────────────────────────────────────────────────
# KAFKA_BOOTSTRAP : adresse vue depuis les conteneurs.
# KAFKA_HEALTH_HOSTPORT : la même chose vue DEPUIS L'HÔTE, utilisée par
# docsearch-kafka-ready.service (voir docsearch-wait-kafka). En
# multi-hôte : <IP_KAFKA>:9092 sur les machines d'ingestion.
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_HEALTH_HOSTPORT=localhost:9092
KAFKA_TOPIC=documents-to-index

# ── Tika ──────────────────────────────────────────────────────
# Ne lister QUE les serveurs Tika réellement démarrés : un serveur
# injoignable dans cette liste fait échouer une extraction sur N. Les
# unités docsearch-tika2/3/4 ne sont pas démarrées par défaut en
# mono-hôte (voir quadlet/README.md) — les ajouter ici en même temps.
TIKA_SERVERS=http://tika1:9998

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Sources de documents ──────────────────────────────────────
# SOURCES_MOUNT      : point de montage À L'INTÉRIEUR des conteneurs.
# SOURCES_HOST_PATH  : le dossier correspondant SUR L'HÔTE.
#
# ⚠️ SOURCES_HOST_PATH doit correspondre au chemin écrit en dur dans les
# unités (Volume=/documents:/sources:ro) : une unité Quadlet ne fait
# aucune substitution de variable. Il ne sert qu'aux commandes
# ponctuelles de manage.sh (init, purge-path…). Pour changer de chemin,
# modifier les DEUX — voir quadlet/README.md (surcharge par drop-in).
SOURCES_MOUNT=/sources
SOURCES_HOST_PATH=/documents
DEFAULT_SOURCE_SUBFOLDER=documents

# ── Indexation ────────────────────────────────────────────────
WORKER_BATCH_SIZE=200
WORKER_FLUSH_INTERVAL=10
WATCHER_POLL_INTERVAL=10
ARCHIVE_MAX_FILES=5000
ARCHIVE_MAX_TOTAL_SIZE_MB=1000
ARCHIVE_MAX_DEPTH=1

# ── Caches de configuration à chaud (secondes) ────────────────
FILETYPE_CONFIG_CACHE_TTL=10
RUNTIME_CONFIG_CACHE_TTL=10
PATHFILTER_CACHE_TTL=10
SOURCES_CONFIG_CACHE_TTL=10
SQL_SOURCES_CACHE_TTL=10
SQL_DSN_REGISTRY_CACHE_TTL=10

# ── Connecteur SQL ────────────────────────────────────────────
SQL_WORKER_MAX_PARALLEL=4
# Clé Fernet de chiffrement des DSN enregistrés depuis le panneau
# d'administration — IDENTIQUE sur l'API et sur l'ingestion. Générer :
#   podman run --rm localhost/docsearch/api:latest python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DSN_ENCRYPTION_KEY=
# DSN référencés par connection_ref dans les sources SQL — une variable
# par base, nom libre (voir HOWTO-creer-source-sql.md) :
#   CLIENTS_DB_DSN=postgresql+psycopg2://user:motdepasse@hote:5432/base

# ── LDAP / Active Directory ───────────────────────────────────
LDAP_ENABLED=false
LDAP_HOST=ldap://dc01.domaine.gouv.fr
LDAP_BASE=dc=domaine,dc=gouv,dc=fr
LDAP_BINDDN=cn=svc-docsearch,ou=services,dc=domaine,dc=gouv,dc=fr
LDAP_PASS=changeme
ADMIN_GROUP=docsearch-admins
ADMIN_AUTH_DISABLED=false
ACCESS_GROUP=docsearch-users
ACCESS_AUTH_DISABLED=false
# Utilisateur simulé en développement (sans SSO) — voir
# HOWTO-simuler-utilisateur.md
DEV_USER=

# ── ACL NTFS sur partages CIFS ────────────────────────────────
CIFS_SID_MAP={}
