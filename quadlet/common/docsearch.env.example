# ─────────────────────────────────────────────────────────────
#  DocSearch — configuration applicative
#  À installer sur chaque machine dans /etc/docsearch/docsearch.env
#  (remplace l'ancien .env de Docker Compose)
# ─────────────────────────────────────────────────────────────
#
# ⚠️ DIFFÉRENCE MAJEURE AVEC .env : ce fichier est lu par systemd
# (EnvironmentFile=), qui ne fait AUCUNE substitution. Pas de
# ${VAR:-defaut}, pas de valeur implicite : toute variable absente d'ici
# est absente du conteneur. Les valeurs par défaut qui vivaient dans
# docker-compose.yml (bloc x-app-env) sont donc toutes écrites ci-dessous.
#
# Pas de guillemets autour des valeurs : systemd les prendrait au pied de
# la lettre et les transmettrait au conteneur.
#
# Après toute modification :
#   sudo systemctl restart docsearch.target

# ── Elasticsearch ─────────────────────────────────────────────
# Adresse vue DEPUIS LES CONTENEURS. En mono-hôte, "es01-dev" est un
# alias réseau du conteneur Elasticsearch (voir docsearch-es01.container).
# En multi-hôte, mettre l'IP réelle du nœud : http://192.168.10.11:9200
ES_HOST=http://es01-dev:9200
ES_INDEX=documents
ES_SEARCH_ALIAS=docsearch-all
SAVED_COLLECTIONS_INDEX=saved_collections
CUSTOM_KEYWORDS_INDEX=custom_keywords

# ── Kafka ─────────────────────────────────────────────────────
# KAFKA_BOOTSTRAP : adresse vue depuis les conteneurs.
# KAFKA_HEALTH_HOSTPORT : la même chose vue DEPUIS L'HÔTE, utilisée par
# docsearch-kafka-ready.service (voir docsearch-wait-kafka). En
# multi-hôte : <IP_KAFKA>:9092 sur les machines d'ingestion.
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_HEALTH_HOSTPORT=localhost:9092
KAFKA_TOPIC=documents-to-index

# ── Tika ──────────────────────────────────────────────────────
# Ne lister QUE les serveurs Tika réellement démarrés : un serveur
# injoignable dans cette liste fait échouer une extraction sur N. Les
# unités docsearch-tika2/3/4 ne sont pas démarrées par défaut en
# mono-hôte (voir quadlet/README.md) — les ajouter ici en même temps.
TIKA_SERVERS=http://tika1:9998

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Sources de documents ──────────────────────────────────────
# SOURCES_MOUNT      : point de montage À L'INTÉRIEUR des conteneurs.
# SOURCES_HOST_PATH  : le dossier correspondant SUR L'HÔTE.
#
# ⚠️ SOURCES_HOST_PATH doit correspondre au chemin écrit en dur dans les
# unités (Volume=/documents:/sources:ro) : une unité Quadlet ne fait
# aucune substitution de variable. Il ne sert qu'aux commandes
# ponctuelles de manage.sh (init, purge-path…). Pour changer de chemin,
# modifier les DEUX — voir quadlet/README.md (surcharge par drop-in).
SOURCES_MOUNT=/sources
SOURCES_HOST_PATH=/documents
DEFAULT_SOURCE_SUBFOLDER=documents

# ── Indexation ────────────────────────────────────────────────
WORKER_BATCH_SIZE=200
WORKER_FLUSH_INTERVAL=10
WATCHER_POLL_INTERVAL=10
ARCHIVE_MAX_FILES=5000
ARCHIVE_MAX_TOTAL_SIZE_MB=1000
ARCHIVE_MAX_DEPTH=1

# ── Caches de configuration à chaud (secondes) ────────────────
FILETYPE_CONFIG_CACHE_TTL=10
RUNTIME_CONFIG_CACHE_TTL=10
PATHFILTER_CACHE_TTL=10
SOURCES_CONFIG_CACHE_TTL=10
SQL_SOURCES_CACHE_TTL=10
SQL_DSN_REGISTRY_CACHE_TTL=10

# ── Connecteur SQL ────────────────────────────────────────────
SQL_WORKER_MAX_PARALLEL=4
# Clé Fernet de chiffrement des DSN enregistrés depuis le panneau
# d'administration — IDENTIQUE sur l'API et sur l'ingestion. Générer :
#   podman run --rm localhost/docsearch/api:latest python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DSN_ENCRYPTION_KEY=
# DSN référencés par connection_ref dans les sources SQL — une variable
# par base, nom libre (voir HOWTO-creer-source-sql.md) :
#   CLIENTS_DB_DSN=postgresql+psycopg2://user:motdepasse@hote:5432/base

# ── Journal du service ────────────────────────────────────────
# Niveau du journal de l'API (journalctl -u docsearch-api). "DEBUG" fait
# notamment apparaître le temps de CHAQUE recherche, utile le temps d'une
# observation, à ne pas laisser en exploitation.
LOG_LEVEL=INFO
# Au-delà de cette durée totale (en millisecondes), une recherche laisse
# une ligne WARNING dans le journal. Toutes les recherches restent
# mesurées et enregistrées dans l'index search_logs quel que soit ce
# réglage : il ne décide que du signalement.
# Garder ALIGNÉ avec la macro Zabbix {$DOCSEARCH.RECHERCHE.MS.MAX}
# (voir zabbix/REFERENCE.md), sinon la supervision alerte sur des
# recherches dont le journal ne dit rien — ou l'inverse.
# 0 désactive la ligne.
SLOW_SEARCH_MS=2000

# ── Environnement ─────────────────────────────────────────────
# "production" VERROUILLE les contournements de développement : l'API
# refuse de démarrer si l'un d'eux est armé (DEV_USER,
# TRUST_X_USER_HEADER, KERBEROS_DEV_PRINCIPAL, *_AUTH_DISABLED) plutôt
# que de les ignorer. Toute autre valeur vaut « développement ».
API_ENV=production

# ── Jetons de session (RS256) ─────────────────────────────────
# À générer AVANT le premier démarrage, sinon aucune connexion n'est
# possible et /auth/login répond 503 :
#   sudo install -d -o 1000 -g 1000 -m 700 /etc/docsearch/jwt
#   sudo podman run --rm -v /etc/docsearch/jwt:/etc/docsearch/jwt:Z \
#        localhost/docsearch/api:latest python scripts/generer-cles.py
# (un conteneur jetable, pas `podman exec` : l'unité monte ce dossier en
#  lecture seule, et l'UID 1000 est celui de l'utilisateur du conteneur)
# La commande écrit dans /etc/docsearch/jwt/<kid>/ (monté en lecture
# seule par l'unité) et affiche les trois lignes ci-dessous.
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
# false uniquement pour une recette en clair — la production est en HTTPS.
# Mal réglé, le symptôme est MUET : la connexion réussit, puis le
# navigateur refuse de renvoyer un cookie Secure sur du clair et chaque
# page ramène au formulaire. L'API l'avertit une fois par démarrage.
COOKIE_SECURE=true
# "lax" si les utilisateurs arrivent par un lien collé dans un mail ou un
# portail intranet : avec "strict", la première requête part sans cookie
# et les renvoie au formulaire.
COOKIE_SAMESITE=strict

# ── LDAP / Active Directory ───────────────────────────────────
LDAP_ENABLED=false
# ldaps:// attendu. "ldap://" (en clair) exige LDAP_ALLOW_PLAINTEXT_INSECURE.
LDAP_HOST=ldaps://dc01.domaine.gouv.fr
LDAP_BASE=dc=domaine,dc=gouv,dc=fr
LDAP_BINDDN=cn=svc-docsearch,ou=services,dc=domaine,dc=gouv,dc=fr
LDAP_PASS=changeme
LDAP_CA_CERT_FILE=
LDAP_ALLOW_PLAINTEXT_INSECURE=false
LDAP_CONNECT_TIMEOUT_SECONDS=5
LDAP_RECEIVE_TIMEOUT_SECONDS=10
LDAP_GROUP_CACHE_TTL_SECONDS=60

ADMIN_GROUP=docsearch-admins
ACCESS_GROUP=docsearch-users

# ── Connexion automatique Kerberos / SPNEGO ───────────────────
# L'interrupteur est dans le panneau d'administration (réglage à chaud),
# désactivé par défaut. Prérequis d'infrastructure : FQDN + DNS + compte
# de service + SPN HTTP/<fqdn> + certificat au même nom + stratégie de
# parc navigateur. Voir PLAN-AUTH-SSO.md §2.5.
KERBEROS_REALM=
KERBEROS_KEYTAB=/etc/docsearch/krb5/docsearch.keytab
KERBEROS_SPN=

# ── ⚠️  Contournements de développement ⚠️  ────────────────────
# Refusés au démarrage si API_ENV=production. Voir
# HOWTO-simuler-utilisateur.md.
ADMIN_AUTH_DISABLED=false
ACCESS_AUTH_DISABLED=false
# Identité par défaut d'une requête non authentifiée.
DEV_USER=
# Croit l'en-tête X-User sur parole — nécessaire au proxy de recette
# (./manage.sh dev-user), et à rien d'autre.
TRUST_X_USER_HEADER=false
# Ouvre une session Kerberos sans ticket, sans keytab et sans KDC.
KERBEROS_DEV_PRINCIPAL=

# ── ACL NTFS sur partages CIFS ────────────────────────────────
CIFS_SID_MAP={}
