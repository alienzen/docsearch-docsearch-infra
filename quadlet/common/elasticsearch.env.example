# ─────────────────────────────────────────────────────────────
#  DocSearch — réglages Elasticsearch
#  À installer dans /etc/docsearch/elasticsearch.env
# ─────────────────────────────────────────────────────────────
#
# Fichier SÉPARÉ de docsearch.env volontairement : les conteneurs
# Elasticsearch n'ont aucune raison de recevoir LDAP_PASS,
# DSN_ENCRYPTION_KEY ou les DSN des bases SQL.
#
# Taille de tas JVM — moitié de la RAM allouée au nœud, jamais plus de
# 31 Go (au-delà, la JVM perd la compression des pointeurs). Les deux
# valeurs doivent être identiques.
#   mono-hôte / VM de développement : -Xms1g -Xmx1g
#   nœud de production dédié        : -Xms4g -Xmx4g
ES_JAVA_OPTS=-Xms1g -Xmx1g
