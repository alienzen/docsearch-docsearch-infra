# ── API de recherche (FastAPI) ────────────────────────────────
# Le code vit dans docsearch-api : après une modification, reconstruire
# l'image (./manage.sh build api) puis redémarrer cette unité.

[Unit]
Description=DocSearch — API de recherche
PartOf=docsearch.target
After=docsearch-redis.service
Requires=docsearch-redis.service

[Container]
ContainerName=docsearch-api
Image=localhost/docsearch/api:latest
Network=docsearch-net.network
PublishPort=8000:8000
PodmanArgs=--network-alias=api
Exec=uvicorn search_api:app --host 0.0.0.0 --port 8000
EnvironmentFile=/etc/docsearch/docsearch.env
# Nécessaire uniquement pour l'aperçu de documents (conversion Office → PDF)
Volume=/documents:/sources:ro

HealthCmd=curl -f http://localhost:8000/health
HealthInterval=20s
HealthTimeout=5s
HealthRetries=5
# /health interroge Elasticsearch, qui peut mettre 60-90 s à démarrer :
# sans cette fenêtre, l'API serait déclarée en échec avant même qu'ES
# soit prêt.
HealthStartPeriod=90s

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=docsearch.target
