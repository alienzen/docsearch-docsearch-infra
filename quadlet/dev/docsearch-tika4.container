# ── Apache Tika (serveur 4) — optionnel ───────────────────────
# Voir docsearch-tika1.container et docsearch-tika2.container.

[Unit]
Description=DocSearch — Apache Tika 4
PartOf=docsearch.target

[Container]
ContainerName=docsearch-tika4
Image=docker.io/apache/tika:3.3.1.0-full
Network=docsearch-net.network
PublishPort=10001:9998
PodmanArgs=--network-alias=tika4

[Service]
Restart=always
RestartSec=10
