# ── Interface web (Vue 3 + DSFR) ──────────────────────────────
# Sert les pages construites par Vite ET proxifie /search, /document,
# /ask... vers l'API : l'interface fonctionne donc seule, sans dépendre
# du reverse proxy de production.
#
# L'amont "api_backend" de son nginx.conf vise l'hôte "api" — d'où
# l'alias réseau du même nom sur docsearch-api.container.

[Unit]
Description=DocSearch — interface web
PartOf=docsearch.target
After=docsearch-api.service

[Container]
ContainerName=docsearch-ui-vue
Image=localhost/docsearch/ui-vue:latest
Network=docsearch-net.network
PublishPort=8080:80
PodmanArgs=--network-alias=ui-vue

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=docsearch.target
