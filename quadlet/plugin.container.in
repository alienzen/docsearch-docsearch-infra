# ── Module complémentaire (modèle) ────────────────────────────
# CE FICHIER N'EST PAS UNE UNITÉ : c'est le modèle à partir duquel
# « ./manage.sh plugin install » génère
# /etc/containers/systemd/docsearch-plugin-<nom>.container, en
# substituant les @MARQUEURS@ à partir du manifeste du module.
#
# Pourquoi une génération et non une unité template systemd
# (docsearch-plugin@.container) : le support des templates par Quadlet
# dépend de la version de podman, et la production vise 4.9. Même
# arbitrage que docsearch-worker.container.in.
#
# ⚠️  PAS d'EnvironmentFile=/etc/docsearch/docsearch.env, contrairement à
# toutes les autres unités de la pile, et c'est délibéré : ce fichier
# porte le mot de passe de liaison LDAP, les DSN des bases SQL et la clé
# de chiffrement des DSN. Un module complémentaire est du code TIERS —
# il reçoit ici le strict nécessaire pour parler à Kafka, et ses propres
# secrets par « podman secret », jamais ceux du produit.
#
# ⚠️  Ce conteneur n'est PAS sur docsearch-net : il vit sur
# docsearch-plugins, d'où Elasticsearch et Redis ne sont ni joignables ni
# même résolvables. Seuls kafka, api et nginx y sont rattachés en plus.
# Voir common/docsearch-plugins.network pour le détail et pour ce qui a
# été vérifié sur podman avant d'en dépendre.

[Unit]
Description=DocSearch — module complémentaire @NOM@
PartOf=docsearch.target
After=docsearch-kafka-ready.service
Requires=docsearch-kafka-ready.service

[Container]
ContainerName=docsearch-plugin-@NOM@
# Alias réseau court et prévisible : c'est ce nom que le fragment nginx
# du module vise (proxy_pass http://plugin-@NOM@:<port>/). Passer par le
# nom de conteneur marcherait aussi, mais lierait le routage à une
# convention de nommage d'unité.
PodmanArgs=--network-alias=plugin-@NOM@
# Étiquette explicite, jamais « latest » : le manifeste l'exige, et la
# production reçoit ses images par transfert manuel.
Image=@IMAGE@
# RÉSEAU DES MODULES, jamais docsearch-net : c'est ce qui met
# Elasticsearch et Redis hors d'atteinte du module. Le changer ici
# rouvrirait le trou que ce réseau existe pour fermer.
Network=docsearch-plugins.network
# Ce que le module a besoin de savoir, et rien de plus. Les valeurs sont
# substituées à l'installation : Quadlet ne résout aucune variable
# (c'est le principal piège de l'orchestration par unités, voir le
# README de docsearch-infra).
Environment=KAFKA_BOOTSTRAP=@KAFKA_BOOTSTRAP@
Environment=DOCSEARCH_TOPIC=@TOPIC@
Environment=DOCSEARCH_PLUGIN=@NOM@
# Bornes de ressources, issues du manifeste. Ce n'est pas une
# optimisation : un module tiers qui part en boucle ne doit pas emporter
# la machine d'ingestion.
PodmanArgs=--cpus=@CPUS@ --memory=@MEMOIRE@
@SECRETS@

[Service]
Restart=always
# Plus long que les unités du cœur : un module tiers qui échoue au
# démarrage ne doit pas saturer le journal en boucle serrée.
RestartSec=30

[Install]
WantedBy=docsearch.target
