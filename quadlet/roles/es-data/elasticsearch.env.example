# ─────────────────────────────────────────────────────────────
#  Nœud de données Elasticsearch — /etc/docsearch/elasticsearch.env
#  À adapter PAR MACHINE (es-data-1 ≠ es-data-2)
# ─────────────────────────────────────────────────────────────
#
# ⚠️ node.name doit être UNIQUE dans le cluster :
#     es-data-1 → es01     es-data-2 → es02
# Deux nœuds portant le même nom refusent de rejoindre le cluster.

node.name=es01
cluster.name=docsearch-cluster
node.roles=master,data

# Les trois nœuds, par IP réelle, port de transport 9300 (PAS 9200) —
# identique sur les 3 machines du cluster.
discovery.seed_hosts=192.168.10.11:9300,192.168.10.12:9300,192.168.10.13:9300
cluster.initial_master_nodes=es01,es02,es03-voting

bootstrap.memory_lock=true
xpack.security.enabled=false

# Moitié de la RAM de la machine, jamais plus de 31 Go. Les deux valeurs
# doivent être identiques.
ES_JAVA_OPTS=-Xms7g -Xmx7g
