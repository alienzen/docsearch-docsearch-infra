# ─────────────────────────────────────────────────────────────
#  Nœud voting-only — /etc/docsearch/elasticsearch.env (es-voting)
# ─────────────────────────────────────────────────────────────

node.name=es03-voting
cluster.name=docsearch-cluster
# voting_only : participe à l'élection du maître, ne stocke aucun shard
node.roles=master,voting_only

discovery.seed_hosts=192.168.10.11:9300,192.168.10.12:9300,192.168.10.13:9300
cluster.initial_master_nodes=es01,es02,es03-voting

bootstrap.memory_lock=true
xpack.security.enabled=false

# 1 Go suffit : ce nœud n'indexe ni ne recherche rien.
ES_JAVA_OPTS=-Xms1g -Xmx1g
