# ─────────────────────────────────────────────────────────────
#  Kibana — /etc/docsearch/kibana.env
# ─────────────────────────────────────────────────────────────

# IP réelle d'un nœud de DONNÉES (pas le nœud voting-only, qui ne
# répond à aucune requête de recherche).
ELASTICSEARCH_HOSTS=http://192.168.10.11:9200
SERVER_PORT=5601

# La télémétrie tente de joindre elastic.co : sans effet fonctionnel sur
# un réseau isolé, mais elle génère du trafic sortant bloqué et du bruit
# dans les journaux.
TELEMETRY_ENABLED=false
