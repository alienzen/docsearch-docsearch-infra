# ── Worker SQL (machine frontend) — non démarré par défaut ────
# Voir docsearch-alert-worker.container pour la raison du [Install]
# absent. À activer si des sources SQL sont enregistrées.
#   sudo systemctl start docsearch-sql-worker

[Unit]
Description=DocSearch — worker SQL
PartOf=docsearch.target
After=docsearch-redis.service
Requires=docsearch-redis.service

[Container]
ContainerName=docsearch-sql-worker
Image=localhost/docsearch/ingestion:latest
Network=docsearch-net.network
Exec=python sql_worker.py
EnvironmentFile=/etc/docsearch/docsearch.env

[Service]
Restart=always
RestartSec=10
