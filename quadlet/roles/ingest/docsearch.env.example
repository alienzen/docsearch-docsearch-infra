# ─────────────────────────────────────────────────────────────
#  Machines d'ingestion — /etc/docsearch/docsearch.env
#  Fichier IDENTIQUE sur ingest-1, ingest-2 et ingest-3
# ─────────────────────────────────────────────────────────────
#
# Remplacer les IP d'exemple par les adresses réelles. Contrairement à
# la pile mono-hôte, aucun nom de service n'est résolvable ici : les
# machines se joignent par IP.

# ── Elasticsearch (nœud de données) ───────────────────────────
ES_HOST=http://192.168.10.11:9200
ES_INDEX=documents
ES_SEARCH_ALIAS=docsearch-all
DEFAULT_SOURCE_SUBFOLDER=documents
SAVED_COLLECTIONS_INDEX=saved_collections
CUSTOM_KEYWORDS_INDEX=custom_keywords

# ── Kafka (machine kafka) ─────────────────────────────────────
# KAFKA_HEALTH_HOSTPORT : la même cible, vue depuis l'hôte, pour
# docsearch-kafka-ready.service.
KAFKA_BOOTSTRAP=192.168.10.14:9092
KAFKA_HEALTH_HOSTPORT=192.168.10.14:9092
KAFKA_TOPIC=documents-to-index

# ── Redis (machine frontend) ──────────────────────────────────
REDIS_HOST=192.168.10.15
REDIS_PORT=6379

# ── Tika — les 6 serveurs des 3 machines d'ingestion ──────────
TIKA_SERVERS=http://192.168.10.16:9998,http://192.168.10.16:9999,http://192.168.10.17:9998,http://192.168.10.17:9999,http://192.168.10.18:9998,http://192.168.10.18:9999

# ── Sources ───────────────────────────────────────────────────
# SOURCES_HOST_PATH doit correspondre au chemin écrit dans les unités
# (Volume=/data/docsearch-sources:/sources:ro) — voir quadlet/README.md.
SOURCES_MOUNT=/sources
SOURCES_HOST_PATH=/data/docsearch-sources

# ── Indexation ────────────────────────────────────────────────
WORKER_BATCH_SIZE=200
WORKER_FLUSH_INTERVAL=10
WATCHER_POLL_INTERVAL=10
ARCHIVE_MAX_FILES=5000
ARCHIVE_MAX_TOTAL_SIZE_MB=1000
ARCHIVE_MAX_DEPTH=1

# ── Caches de configuration à chaud (secondes) ────────────────
FILETYPE_CONFIG_CACHE_TTL=10
RUNTIME_CONFIG_CACHE_TTL=10
PATHFILTER_CACHE_TTL=10
SOURCES_CONFIG_CACHE_TTL=10
SQL_SOURCES_CACHE_TTL=10
SQL_DSN_REGISTRY_CACHE_TTL=10
SQL_WORKER_MAX_PARALLEL=4
DSN_ENCRYPTION_KEY=

# ── ACL NTFS sur partages CIFS ────────────────────────────────
CIFS_SID_MAP={}
