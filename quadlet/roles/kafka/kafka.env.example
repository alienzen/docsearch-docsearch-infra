# ─────────────────────────────────────────────────────────────
#  Kafka — /etc/docsearch/kafka.env (machine kafka)
# ─────────────────────────────────────────────────────────────
#
# ⚠️ Remplacer 192.168.10.14 par l'IP RÉELLE de cette machine dans les
# deux variables ci-dessous. KAFKA_ADVERTISED_LISTENERS est l'adresse
# que le broker communique à ses clients : avec "localhost", les workers
# des machines d'ingestion se connecteraient à eux-mêmes.

KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@192.168.10.14:9093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://192.168.10.14:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Partitions des topics auto-créés — plafond du parallélisme d'un groupe
# de consumers. Doit rester >= au nombre total de workers des 3 machines
# d'ingestion, sinon les workers excédentaires resteront inactifs.
KAFKA_NUM_PARTITIONS=16
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_MESSAGE_MAX_BYTES=10485760

# Identifiant de cluster KRaft — ne JAMAIS le changer sur un cluster
# déjà formaté : le broker refuserait de redémarrer sur ses données.
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qg
